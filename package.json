{
  "name": "pixlprfct",
  "version": "0.1.1-alpha.20",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "npm run build:editor && node scripts/prepare-editor.mjs && node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "cargo test && node --test tests/*.test.mjs",
    "build:editor": "node scripts/generate-preloader.mjs && wasm-pack build --target web --out-dir web/pkg && node scripts/generate-editor-api.mjs && node scripts/build-figma-import.mjs && node scripts/build.mjs",
    "dev:editor": "node scripts/serve.mjs",
    "build:static": "npm run build:editor && node scripts/build-static.mjs",
    "mcp": "node mcp/server.mjs",
    "mcp:catalog": "node scripts/generate-editor-api.mjs",
    "mcp:check": "node scripts/generate-editor-api.mjs --check && node --test tests/mcp*.test.mjs",
    "selfhost:setup": "node scripts/self-host/setup.mjs",
    "selfhost:migrate": "node --env-file=.env.selfhost scripts/self-host/migrate.mjs",
    "selfhost:start": "node --env-file=.env.selfhost server/index.mjs",
    "selfhost:build": "npm run build:editor",
    "desktop:prepare": "npm run build:editor && node scripts/desktop/prepare.mjs",
    "desktop:dev": "npm run desktop:prepare && electron .desktop/app",
    "desktop:pack": "npm run desktop:prepare && node scripts/desktop/build.mjs --dir",
    "desktop:mac": "npm run desktop:prepare && node scripts/desktop/build.mjs --mac",
    "desktop:win": "npm run desktop:prepare && node scripts/desktop/build.mjs --win",
    "desktop:mas": "npm run desktop:prepare && node scripts/desktop/build.mjs --mas",
    "desktop:mas:dev": "npm run desktop:prepare && node scripts/desktop/build.mjs --mas-dev",
    "desktop:check": "node --test tests/desktop.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "test:idle": "node scripts/acceptance/mcp-idle.mjs 40",
    "benchmark:editor": "node scripts/acceptance/benchmark.mjs",
    "test:sleep": "node scripts/acceptance/desktop-sleep.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@shadcn/react": "^0.3.0",
    "better-auth": "1.7.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fflate": "0.8.3",
    "fzstd": "0.1.1",
    "input-otp": "^1.4.2",
    "kiwi-schema": "0.5.0",
    "lucide-react": "^1.31.0",
    "mysql2": "3.24.6",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.10",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.4.0",
    "vite": "8.3.5",
    "wasm-pack": "^0.15.0",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "$sharp"
    },
    "esbuild": "$esbuild",
    "sharp": "$sharp",
    "undici": "7.30.1",
    "@babel/core": "7.29.7",
    "fflate": "$fflate",
    "ws": "$ws",
    "minimatch@>=9.0.0 <11.0.1": "11.0.3"
  }
}
