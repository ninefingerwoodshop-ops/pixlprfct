FROM rust:1-bookworm AS engine
RUN cargo install wasm-pack --locked
WORKDIR /build
COPY Cargo.toml Cargo.lock LICENSE ./
COPY src ./src
RUN wasm-pack build --target web --out-dir pkg

FROM node:24-bookworm-slim AS dependencies
WORKDIR /app
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-fund --no-audit

FROM node:24-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json ./
COPY LICENSE ./
COPY docs/licenses ./licenses
COPY server ./server
COPY lib ./lib
COPY scripts/self-host ./scripts/self-host
COPY mcp/installation-runner.mjs ./mcp/installation-runner.mjs
COPY web ./web
COPY --from=engine /build/pkg ./web/pkg
RUN mkdir -p /app/data && chmod 700 /app/data && chown -R node:node /app
USER node
EXPOSE 4174
CMD ["node", "server/index.mjs"]
